# ── secrets: never committed ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.key

# ── raw CIC-IDS 2017 data: not ours to redistribute; download from UNB/CIC ──
data/raw/*
!data/raw/.gitkeep
*.zip
*.pcap
*.pcap_ISCX.csv

# ── LLM cache and run directories: large, re-creatable ────────────────────
llm_cache/
runs/
*.sqlite

# ── legacy pipeline working files ─────────────────────────────────────────
data/processed/*.json
data/annotations/*.json
outputs/*
!outputs/.gitkeep

# ── Python, environments, editors, local scratch ──────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
env/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp

# ── local working instructions (kept on disk, never published) ────────────
local_notes/

# ── hand-over packages and paper-side delivery folders (local only) ───────
outbox/
paper_side_*/

# Shipped on purpose (NOT ignored): results/, annotation/, old_run/ (the earlier run's 7 JSON files, needed to
# reproduce the existing-corpus analysis; see README "Data").
